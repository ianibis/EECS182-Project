\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Per-day test $R^2$ on the five held-out test days. (a) clean input, the same-day stimulation-off recording. (b) stimulated input, the stimulation-on recording. Each bar is the mean of the session-level $R^2$ over the sessions of that day: blue is the mean of the five seeds, orange is the five-seed prediction ensemble of \eqref  {eq:ensemble}, green is a decoder trained with synthetic tones (Appendix~\ref {app:tones}). Every $R^2$ is the average of the $v_x$ and $v_y$ scores, and $0$ is the constant-mean predictor.}}{18}{figure.caption.33}\protected@file@percent }
\newlabel{fig:perday}{{9}{18}{Per-day test $R^2$ on the five held-out test days. (a) clean input, the same-day stimulation-off recording. (b) stimulated input, the stimulation-on recording. Each bar is the mean of the session-level $R^2$ over the sessions of that day: blue is the mean of the five seeds, orange is the five-seed prediction ensemble of \eqref {eq:ensemble}, green is a decoder trained with synthetic tones (Appendix~\ref {app:tones}). Every $R^2$ is the average of the $v_x$ and $v_y$ scores, and $0$ is the constant-mean predictor}{figure.caption.33}{}}
