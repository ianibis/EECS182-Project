\newlabel{app:tones}{{H}{20}{Synthetic tone augmentation}{appendix.H}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Tone augmentation on a real stimulation-off training trial. (a) A clean trial $x_c(t)$ receives a synthetic tone $A g_c\sin (2\pi f t+\phi )$ to form $x'_c(t)$; the target velocities are unchanged. Each training trial draws one frequency $f\in \{3,20\}$~Hz, amplitude $A\in [0.5,3.0]$ robust $z$, phase $\phi \in [0,2\pi )$, and one gain $g_c\in [0.5,1.5]$ per channel. (b) The clean trial (session Butters-250522-095740, trial 0, channel 28). (c) The same trial with an illustrative 3~Hz tone ($A=1.5$~z, $g_c=1.0$). (d) The actual seed-0 draw for this trial: 20~Hz, $A=1.17$~z, $\phi =0.26$~rad, $g_c=0.89$. (e) A 0.25~s zoom comparing the clean and augmented traces. The dashed curves in (c)--(d) are the added tones, plotted at zero offset. The augmentation is applied only to the stimulation-off training set, and the same augmented set is reused across all five seeds.}}{20}{figure.caption.38}\protected@file@percent }
\newlabel{fig:toneaug}{{12}{20}{Tone augmentation on a real stimulation-off training trial. (a) A clean trial $x_c(t)$ receives a synthetic tone $A g_c\sin (2\pi f t+\phi )$ to form $x'_c(t)$; the target velocities are unchanged. Each training trial draws one frequency $f\in \{3,20\}$~Hz, amplitude $A\in [0.5,3.0]$ robust $z$, phase $\phi \in [0,2\pi )$, and one gain $g_c\in [0.5,1.5]$ per channel. (b) The clean trial (session Butters-250522-095740, trial 0, channel 28). (c) The same trial with an illustrative 3~Hz tone ($A=1.5$~z, $g_c=1.0$). (d) The actual seed-0 draw for this trial: 20~Hz, $A=1.17$~z, $\phi =0.26$~rad, $g_c=0.89$. (e) A 0.25~s zoom comparing the clean and augmented traces. The dashed curves in (c)--(d) are the added tones, plotted at zero offset. The augmentation is applied only to the stimulation-off training set, and the same augmented set is reused across all five seeds}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Clean validation $R^2$ across training epochs for the five tone-augmented runs. One colour per run; the bold black line is the seed mean, the dashed line its 5-epoch running average, and the red dots mark the kept checkpoints. The dotted line is the unaugmented baseline mean of 0.136, so the whole cluster sits below it: tones buy stimulated robustness at a cost in clean accuracy.}}{21}{figure.caption.39}\protected@file@percent }
\newlabel{fig:tonescurves}{{13}{21}{Clean validation $R^2$ across training epochs for the five tone-augmented runs. One colour per run; the bold black line is the seed mean, the dashed line its 5-epoch running average, and the red dots mark the kept checkpoints. The dotted line is the unaugmented baseline mean of 0.136, so the whole cluster sits below it: tones buy stimulated robustness at a cost in clean accuracy}{figure.caption.39}{}}
