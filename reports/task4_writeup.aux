\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 3~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient, against the same-day unstimulated recording on the same channel. (b) the whole stimulation recording folded at the 333~ms period: the line is the median over cycles and the band the interquartile range, so a handful of multi-thousand-$z$ transients cannot set the curve. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped). The fold is flat, so the artifact carries no stable periodic template to estimate; what the decoder has to survive is the transient and its slow decay in (a).}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:artifact3}{{1}{4}{3~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient, against the same-day unstimulated recording on the same channel. (b) the whole stimulation recording folded at the 333~ms period: the line is the median over cycles and the band the interquartile range, so a handful of multi-thousand-$z$ transients cannot set the curve. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped). The fold is flat, so the artifact carries no stable periodic template to estimate; what the decoder has to survive is the transient and its slow decay in (a)}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 20~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient: a step to about 7000~$z$ followed by a decay of several hundred milliseconds, so one transient outlasts many 50~ms periods. (b) the whole recording folded at the 50~ms period and high-passed above 5~Hz to remove the slow step; the line is the median over cycles and the band the interquartile range. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped).}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:artifact20}{{2}{5}{20~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient: a step to about 7000~$z$ followed by a decay of several hundred milliseconds, so one transient outlasts many 50~ms periods. (b) the whole recording folded at the 50~ms period and high-passed above 5~Hz to remove the slow step; the line is the median over cycles and the band the interquartile range. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped)}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Task 4 dataset, tensor shapes, splits, and calibration protocol ($C=35$ channels, $T=2{,}000$ samples, $N=40$ 50\,ms bins, $V=2$ velocity axes).}}{6}{table.caption.11}\protected@file@percent }
