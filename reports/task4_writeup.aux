\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Causal EEGNet forward pass (read down the left column, then the right). Stacked sheets denote batch $B$; each sheet is drawn at the real extent of its stage, so the height falls from $C=35$ channels to one and the width from $T=2{,}000$ samples to $N=40$ 50-ms bins and finally $(B,N,V)$. Pooling is average ($P=2$, then $Q=25$); dropout is $p=0.25$; all convolutions are causal.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:arch}{{4}{8}{Causal EEGNet forward pass (read down the left column, then the right). Stacked sheets denote batch $B$; each sheet is drawn at the real extent of its stage, so the height falls from $C=35$ channels to one and the width from $T=2{,}000$ samples to $N=40$ 50-ms bins and finally $(B,N,V)$. Pooling is average ($P=2$, then $Q=25$); dropout is $p=0.25$; all convolutions are causal}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces One causal temporal convolution on a single 1D LFP trial. The input is left-padded with $K_1-1=499$ zeros (grey); the $1\times K_1$ kernel ($K_1=500$ samples, 500~ms) slides left to right. The first output $y[0]$ sees 499 zeros plus $x[0]$; $y[250]$ sees 249 zeros plus $x[0..250]$; after 500 samples the kernel is fully inside the signal. No output sees a future sample. The same left-only scheme is used for the $K_2=62$ separable convolution.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:conv}{{5}{9}{One causal temporal convolution on a single 1D LFP trial. The input is left-padded with $K_1-1=499$ zeros (grey); the $1\times K_1$ kernel ($K_1=500$ samples, 500~ms) slides left to right. The first output $y[0]$ sees 499 zeros plus $x[0]$; $y[250]$ sees 249 zeros plus $x[0..250]$; after 500 samples the kernel is fully inside the signal. No output sees a future sample. The same left-only scheme is used for the $K_2=62$ separable convolution}{figure.caption.14}{}}
