\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Causal EEGNet forward pass (read down the left column, then the right). Stacked sheets are the $B$ samples of one batch, each drawn at the real extent of its stage, so the height falls from $C=35$ channels to one and the width from $T=2{,}000$ samples to $N=40$ 50-ms bins and finally $(B,N,V)$ with $V=2$. The stages use $F_1=8$ temporal filters, depth multiplier $D=2$ ($F_2=16$), kernel lengths $K_1=500$ and $K_2=62$ samples, average pooling $P=2$ then $Q=25$, and dropout $p=0.25$. Inputs are fixed $z$-scores and every convolution is followed by \texttt  {BatchNorm2d}; pooling is average, and all convolutions are causal (left-only zero padding). Weight matrices are trained with Muon, and biases and BatchNorm affine parameters with Adam.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:arch}{{5}{7}{Causal EEGNet forward pass (read down the left column, then the right). Stacked sheets are the $B$ samples of one batch, each drawn at the real extent of its stage, so the height falls from $C=35$ channels to one and the width from $T=2{,}000$ samples to $N=40$ 50-ms bins and finally $(B,N,V)$ with $V=2$. The stages use $F_1=8$ temporal filters, depth multiplier $D=2$ ($F_2=16$), kernel lengths $K_1=500$ and $K_2=62$ samples, average pooling $P=2$ then $Q=25$, and dropout $p=0.25$. Inputs are fixed $z$-scores and every convolution is followed by \texttt {BatchNorm2d}; pooling is average, and all convolutions are causal (left-only zero padding). Weight matrices are trained with Muon, and biases and BatchNorm affine parameters with Adam}{figure.5}{}}
