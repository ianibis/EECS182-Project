\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Validation $R^2$ during training for the five seeds. (a) Decoders trained on \textbf  {stimulation-off} trials only; validation uses 150 held-off stimulation-off trials. (b) The stimulation-facing arm: the same stimulation-off training trials with synthetic 3/20~Hz tones added (Appendix~\ref {app:tones}), so no stimulated recordings or labels are used and validation remains on clean stimulation-off trials. One colour per run; the bold black line is the epoch-wise mean of the five runs, the dashed line its 5-epoch running average, and the red dots mark the checkpoint each run kept. The five kept scores average $0.136\pm 0.011$ in (a) and $0.067\pm 0.006$ in (b); the dotted line in (b) is the stimulation-off mean of (a).}}{10}{figure.caption.17}\protected@file@percent }
\newlabel{fig:curves}{{7}{10}{Validation $R^2$ during training for the five seeds. (a) Decoders trained on \textbf {stimulation-off} trials only; validation uses 150 held-off stimulation-off trials. (b) The stimulation-facing arm: the same stimulation-off training trials with synthetic 3/20~Hz tones added (Appendix~\ref {app:tones}), so no stimulated recordings or labels are used and validation remains on clean stimulation-off trials. One colour per run; the bold black line is the epoch-wise mean of the five runs, the dashed line its 5-epoch running average, and the red dots mark the checkpoint each run kept. The five kept scores average $0.136\pm 0.011$ in (a) and $0.067\pm 0.006$ in (b); the dotted line in (b) is the stimulation-off mean of (a)}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Validation sweeps used to choose the ridge penalty and the KNN neighbour count. Top row: ridge $\alpha $ on a log scale for raw OFF (solid) and raw ON (dashed) input, with validation $R^2$ (left) and RMSE (right); the dotted line marks the selected $\alpha =10^5$. Bottom row: KNN neighbours for the OFF bank, ON bank, and ON calibration. Selection uses mean validation $R^2$; RMSE is shown for comparison. The current code tunes on ON validation sessions, and the OFF curves show the no-stimulation split for reference. PARRM overlaps the raw ridge curves.}}{11}{figure.caption.20}\protected@file@percent }
\newlabel{fig:sweeps}{{8}{11}{Validation sweeps used to choose the ridge penalty and the KNN neighbour count. Top row: ridge $\alpha $ on a log scale for raw OFF (solid) and raw ON (dashed) input, with validation $R^2$ (left) and RMSE (right); the dotted line marks the selected $\alpha =10^5$. Bottom row: KNN neighbours for the OFF bank, ON bank, and ON calibration. Selection uses mean validation $R^2$; RMSE is shown for comparison. The current code tunes on ON validation sessions, and the OFF curves show the no-stimulation split for reference. PARRM overlaps the raw ridge curves}{figure.caption.20}{}}
