\@writefile{toc}{\contentsline {paragraph}{Architecture and training.}{1}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Causal GRU decoder: sequence-to-sequence regression on per-bin spectral features. A 2.0~s trial is unrolled left-to-right over its $N=40$ 50-ms bins; features are robust $z$-scored per session, and trials stay as sequences, so the GRU reads $(B,N,280)$ with the batch first. The purple arrows are the recurrent (recursive) memory: the cell receives $\mathbf  {h}_{b-1}$, and the same 256-unit cell and linear $256\to 2$ head are reused at every bin, so the state at bin $b$ depends only on bins $1..b$ (strictly causal, no padding). The right panel opens one cell ($z$ update, $r$ reset, $n$ candidate; $\mathbf  {h}_0=\mathbf  {0}$). One layer, dropout $p=0$ (identity) at the reported setting; the head is applied to every hidden state. Parameters: $3\times (280{\cdot }256+256{\cdot }256+2{\cdot }256)=413{,}184$ in the GRU plus $256{\cdot }2+2=514$ in the head, $413{,}698$ total.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:gru}{{1}{1}{Causal GRU decoder: sequence-to-sequence regression on per-bin spectral features. A 2.0~s trial is unrolled left-to-right over its $N=40$ 50-ms bins; features are robust $z$-scored per session, and trials stay as sequences, so the GRU reads $(B,N,280)$ with the batch first. The purple arrows are the recurrent (recursive) memory: the cell receives $\mathbf {h}_{b-1}$, and the same 256-unit cell and linear $256\to 2$ head are reused at every bin, so the state at bin $b$ depends only on bins $1..b$ (strictly causal, no padding). The right panel opens one cell ($z$ update, $r$ reset, $n$ candidate; $\mathbf {h}_0=\mathbf {0}$). One layer, dropout $p=0$ (identity) at the reported setting; the head is applied to every hidden state. Parameters: $3\times (280{\cdot }256+256{\cdot }256+2{\cdot }256)=413{,}184$ in the GRU plus $256{\cdot }2+2=514$ in the head, $413{,}698$ total}{figure.caption.2}{}}
