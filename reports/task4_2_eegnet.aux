\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Best validation $R^2$ for each of the five runs with and without tone augmentation. Each dot is one seed; the horizontal bar is the mean and the whisker $\pm 1$ SD. The no-tone SD (0.011) is the resolution limit used in \S  \ref {sec:seeds}; tone augmentation lowers the mean to $0.067\pm 0.006$.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:seedspread}{{4}{9}{Best validation $R^2$ for each of the five runs with and without tone augmentation. Each dot is one seed; the horizontal bar is the mean and the whisker $\pm 1$ SD. The no-tone SD (0.011) is the resolution limit used in \S \ref {sec:seeds}; tone augmentation lowers the mean to $0.067\pm 0.006$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Validation $R^2$ during training for the five seeds. One colour per run; the bold black line is the epoch-wise mean of the five runs, the dashed line its 5-epoch running average, and the red dots mark the checkpoint each run kept. The five kept scores average $0.136\pm 0.011$ (reported in the text).}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:curves}{{5}{9}{Validation $R^2$ during training for the five seeds. One colour per run; the bold black line is the epoch-wise mean of the five runs, the dashed line its 5-epoch running average, and the red dots mark the checkpoint each run kept. The five kept scores average $0.136\pm 0.011$ (reported in the text)}{figure.5}{}}
