\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Cycle-averaged artifact amplitude and peak transients in robust $z$-units.}}{13}{table.7}\protected@file@percent }
\newlabel{tab:artifact}{{7}{13}{Cycle-averaged artifact amplitude and peak transients in robust $z$-units}{table.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 3~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient, against the same-day unstimulated recording on the same channel. (b) the whole stimulation recording folded at the 333~ms period: the line is the median over cycles and the band the interquartile range, so a handful of multi-thousand-$z$ transients cannot set the curve. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped). The fold is flat, so the artifact carries no stable periodic template to estimate; what the decoder has to survive is the transient and its slow decay in (a).}}{14}{figure.10}\protected@file@percent }
\newlabel{fig:artifact3}{{10}{14}{3~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient, against the same-day unstimulated recording on the same channel. (b) the whole stimulation recording folded at the 333~ms period: the line is the median over cycles and the band the interquartile range, so a handful of multi-thousand-$z$ transients cannot set the curve. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped). The fold is flat, so the artifact carries no stable periodic template to estimate; what the decoder has to survive is the transient and its slow decay in (a)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 20~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient: a step to about 7000~$z$ followed by a decay of several hundred milliseconds, so one transient outlasts many 50~ms periods. (b) the whole recording folded at the 50~ms period and high-passed above 5~Hz to remove the slow step; the line is the median over cycles and the band the interquartile range. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped).}}{15}{figure.11}\protected@file@percent }
\newlabel{fig:artifact20}{{11}{15}{20~Hz stimulation day, worst channel. (a) one second of raw LFP around the largest transient: a step to about 7000~$z$ followed by a decay of several hundred milliseconds, so one transient outlasts many 50~ms periods. (b) the whole recording folded at the 50~ms period and high-passed above 5~Hz to remove the slow step; the line is the median over cycles and the band the interquartile range. Red is the stimulated recording; the grey dashed line is the same-day unstimulated reference; the red band is the 25--75\% range (not clipped)}{figure.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {G}Synthetic tone augmentation}{15}{appendix.G}\protected@file@percent }
\newlabel{app:tones}{{G}{15}{Synthetic tone augmentation}{appendix.G}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Tone augmentation on a real stimulation-off training trial. (a) A clean trial $x_c(t)$ receives a synthetic tone $A g_c\sin (2\pi f t+\phi )$ to form $x'_c(t)$; the target velocities are unchanged. Each training trial draws one frequency $f\in \{3,20\}$~Hz, amplitude $A\in [0.5,3.0]$ robust $z$, phase $\phi \in [0,2\pi )$, and one gain $g_c\in [0.5,1.5]$ per channel. (b) The clean trial (session Butters-250522-095740, trial 0, channel 28). (c) The same trial with an illustrative 3~Hz tone ($A=1.5$~z, $g_c=1.0$). (d) The actual seed-0 draw for this trial: 20~Hz, $A=1.17$~z, $\phi =0.26$~rad, $g_c=0.89$. (e) A 0.25~s zoom comparing the clean and augmented traces. The dashed curves in (c)--(d) are the added tones, plotted at zero offset. The augmentation is applied only to the stimulation-off training set, and the same augmented set is reused across all five seeds.}}{16}{figure.12}\protected@file@percent }
\newlabel{fig:toneaug}{{12}{16}{Tone augmentation on a real stimulation-off training trial. (a) A clean trial $x_c(t)$ receives a synthetic tone $A g_c\sin (2\pi f t+\phi )$ to form $x'_c(t)$; the target velocities are unchanged. Each training trial draws one frequency $f\in \{3,20\}$~Hz, amplitude $A\in [0.5,3.0]$ robust $z$, phase $\phi \in [0,2\pi )$, and one gain $g_c\in [0.5,1.5]$ per channel. (b) The clean trial (session Butters-250522-095740, trial 0, channel 28). (c) The same trial with an illustrative 3~Hz tone ($A=1.5$~z, $g_c=1.0$). (d) The actual seed-0 draw for this trial: 20~Hz, $A=1.17$~z, $\phi =0.26$~rad, $g_c=0.89$. (e) A 0.25~s zoom comparing the clean and augmented traces. The dashed curves in (c)--(d) are the added tones, plotted at zero offset. The augmentation is applied only to the stimulation-off training set, and the same augmented set is reused across all five seeds}{figure.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Validation $R^2$ on clean trials for tone-augmented runs.}}{16}{table.8}\protected@file@percent }
\newlabel{tab:toneseeds}{{8}{16}{Validation $R^2$ on clean trials for tone-augmented runs}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Clean validation $R^2$ across training epochs for the five tone-augmented runs. One colour per run; the bold black line is the seed mean, the dashed line its 5-epoch running average, and the red dots mark the kept checkpoints. The dotted line is the unaugmented baseline mean of 0.136, so the whole cluster sits below it: tones buy stimulated robustness at a cost in clean accuracy.}}{17}{figure.13}\protected@file@percent }
\newlabel{fig:tonescurves}{{13}{17}{Clean validation $R^2$ across training epochs for the five tone-augmented runs. One colour per run; the bold black line is the seed mean, the dashed line its 5-epoch running average, and the red dots mark the kept checkpoints. The dotted line is the unaugmented baseline mean of 0.136, so the whole cluster sits below it: tones buy stimulated robustness at a cost in clean accuracy}{figure.13}{}}
