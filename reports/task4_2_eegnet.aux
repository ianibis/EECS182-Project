\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-day test $R^2$ on the five held-out test days. (a) clean input, the same-day stimulation-off recording. (b) stimulated input, the stimulation-on recording. Each bar is the mean of the session-level $R^2$ over the sessions of that day: blue is the mean of the five seeds, orange is the five-seed prediction ensemble of \eqref  {eq:ensemble}, green is a decoder trained with synthetic tones (Appendix~\ref {app:tones}). Every $R^2$ is the average of the $v_x$ and $v_y$ scores, and $0$ is the constant-mean predictor.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:perday}{{6}{10}{Per-day test $R^2$ on the five held-out test days. (a) clean input, the same-day stimulation-off recording. (b) stimulated input, the stimulation-on recording. Each bar is the mean of the session-level $R^2$ over the sessions of that day: blue is the mean of the five seeds, orange is the five-seed prediction ensemble of \eqref {eq:ensemble}, green is a decoder trained with synthetic tones (Appendix~\ref {app:tones}). Every $R^2$ is the average of the $v_x$ and $v_y$ scores, and $0$ is the constant-mean predictor}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Clean-input $R^2$ per held-out test day. All seeds are plotted at the same day position; colours and marker shapes distinguish them. The solid line joins the mean of the five seeds, and the black diamonds are the five-seed ensemble of \eqref  {eq:ensemble}. The gap between the solid line and the diamonds is the gain from averaging predictions rather than scores. $R^2$ is the average of the $v_x$ and $v_y$ scores; $0$ is the constant-mean predictor.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:ensemble}{{7}{10}{Clean-input $R^2$ per held-out test day. All seeds are plotted at the same day position; colours and marker shapes distinguish them. The solid line joins the mean of the five seeds, and the black diamonds are the five-seed ensemble of \eqref {eq:ensemble}. The gap between the solid line and the diamonds is the gain from averaging predictions rather than scores. $R^2$ is the average of the $v_x$ and $v_y$ scores; $0$ is the constant-mean predictor}{figure.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Velocity error in cm/s and comparison to ridge.}{11}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces From $R^2$ to centimetres per second, all on clean input. (a) measured and predicted $v_x$ over the first 10~s of one held-out session. (b) predicted against measured velocity for every scored bin of that session, with the diagonal as a perfect forecast; the prediction is compressed toward zero, which is why $R^2$ stays positive while the scatter is wide. (c) per-day Euclidean velocity RMSE, $\sqrt  {e_{v_x}^2+e_{v_y}^2}$, against the constant-mean predictor, whose error is $\sqrt  {2}\,\mathrm  {SD}(\text  {speed})$. Day identity is on the axis because RMSE is not comparable across days of different speed.}}{11}{figure.8}\protected@file@percent }
\newlabel{fig:r2rmse}{{8}{11}{From $R^2$ to centimetres per second, all on clean input. (a) measured and predicted $v_x$ over the first 10~s of one held-out session. (b) predicted against measured velocity for every scored bin of that session, with the diagonal as a perfect forecast; the prediction is compressed toward zero, which is why $R^2$ stays positive while the scatter is wide. (c) per-day Euclidean velocity RMSE, $\sqrt {e_{v_x}^2+e_{v_y}^2}$, against the constant-mean predictor, whose error is $\sqrt {2}\,\mathrm {SD}(\text {speed})$. Day identity is on the axis because RMSE is not comparable across days of different speed}{figure.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-day test performance across models (clean and stimulated $R^2$, plus clean RMSE in cm/s). Bold marks the best model in each row: highest $R^2$, lowest RMSE. Mean pred.\ is the constant-velocity reference, not a model, so it is never bold.}}{11}{table.5}\protected@file@percent }
\newlabel{tab:perday}{{5}{11}{Per-day test performance across models (clean and stimulated $R^2$, plus clean RMSE in cm/s). Bold marks the best model in each row: highest $R^2$, lowest RMSE. Mean pred.\ is the constant-velocity reference, not a model, so it is never bold}{table.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {E}Supervised recalibration: PARRM cleaning and ridge refitting}{11}{appendix.E}\protected@file@percent }
\newlabel{app:parrm}{{E}{11}{Supervised recalibration: PARRM cleaning and ridge refitting}{appendix.E}{}}
